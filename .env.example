# Local development defaults
DEBUG=True
SECRET_KEY=replace-with-a-long-random-value
# DJANGO_SECRET_KEY is also accepted for Vercel's Django template convention.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=sqlite:///db.sqlite3
# Supabase's Vercel integration provides POSTGRES_URL automatically.
POSTGRES_URL=
TIME_ZONE=Asia/Dhaka
MEDIA_URL=/media/
MEDIA_ROOT=media
# Leave these blank locally unless you want uploads to use Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=foodfanatic-media

# Email defaults to the console backend in development. Use the SMTP settings
# below only in a local `.env` file or Vercel's encrypted environment variables.
# Never place a real email address or app password in this tracked template.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FoodFanatic <no-reply@example.com>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Production hardening
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
